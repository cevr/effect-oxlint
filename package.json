{
  "name": "oxlint-plugin-effect",
  "version": "0.32.4",
  "description": "oxlint plugin with Effect-specific lint rules",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cevr/effect-oxlint"
  },
  "files": [
    "dist",
    "presets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      }
    },
    "./rule-bindings": {
      "import": {
        "types": "./dist/vendor/effect-oxlint/index.d.ts",
        "default": "./dist/vendor/effect-oxlint/index.js"
      }
    },
    "./presets/recommended.json": "./presets/recommended.json",
    "./presets/*.json": "./presets/*.json",
    "./presets/*": {
      "import": {
        "types": "./dist/presets/*.d.ts",
        "default": "./dist/presets/*.js"
      }
    }
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "lint": "concurrently -n ox,effect -c yellow,blue \"oxlint\" \"bun run lint:effect\"",
    "lint:ox": "oxlint",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --lspconfig \"$(cat .effect-lsp.json)\"",
    "lint:self": "oxlint -c oxlint.self.config.ts src scripts tests",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun run build && bun test --timeout=30000",
    "gate": "bun run build && concurrently -n type,style,self,generated,test -c blue,yellow,cyan,magenta,green \"bun run typecheck\" \"bun run lint\" \"bun run lint:self\" \"bun run codegen:check\" \"bun test --timeout=30000\"",
    "codegen": "bun run scripts/codegen.ts",
    "codegen:check": "bun run scripts/codegen.ts --check",
    "add-rule": "bun run scripts/add-rule.ts",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.94.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@cvr/tn1-lint": "^0.1.0",
    "@effect/tsgo": "latest",
    "@effect/vitest": "4.1.4",
    "@types/bun": "latest",
    "@typescript/native-preview": "latest",
    "concurrently": "latest",
    "effect": "4.1.4",
    "effect-4.0.0": "npm:effect@4.0.0",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "tsdown": "^0.23.7",
    "typescript": "latest",
    "unrun": "^0.3.1",
    "vitest": "latest"
  },
  "peerDependencies": {
    "@cvr/tn1-lint": ">=0.1.0",
    "effect": ">=4.1.0 <5"
  },
  "peerDependenciesMeta": {
    "@cvr/tn1-lint": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.4"
}
